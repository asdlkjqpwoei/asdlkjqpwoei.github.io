<article class="post" itemscope itemtype="http://schema.org/BlogPosting">
	<%- partial('_partial/post/gallery') %>
	<div class="content" itemprop="articleBody">
		<% if (page.search || page.type === "search") { %>
		<%- partial('_partial/search') %>
		<% } else if (page.type === "tags") { %>
			<div id="tag-cloud">
			<div class="tag-cloud-title">
				<% var visibleTags = 0 %>
				<% site.tags.each(function(tag) { %>
					<% if (tag.length) { %>
					<% visibleTags += 1 %>
					<% } %>
				<% }) %>
				<%- _p('counter.tag_cloud', visibleTags) %>
			</div>
			<div class="tag-cloud-tags">
				<%- tagcloud({min_font: 12, max_font: 30, amount: 300}) %>
			</div>
			</div>
		<% } else if (page.type === 'categories') { %>
			<div id="categories">
			<div class="category-list-title">
				<% var visibleCategories = 0 %>
				<% site.categories.each(function(cat) { %>
					<% if (cat.length) { %>
					<% visibleCategories += 1 %>
					<% } %>
				<% }) %>
				<%- _p('counter.categories', visibleCategories) %>
			</div>
			<div class="category-list">
				<%- list_categories() %>
			</div>
			</div>
		<% } else if (page.type === 'categories_list') { %>
			<div id = "categories-list">
			<div class = "categories-list">
				<% site.categories.sort('name').each(function(category) { %>
				<!-- 类别大标题 -->
				<h2 class = "category-title" id = "<%= category.name%>">
					<%= category.name %>
				</h2>
				<ul class = "post-list">
				<!-- 按照最新更新时间（若无更新时间则按创建时间）倒序排列 -->
					<% var posts_in_cat = category.posts.sort(function(a, b) {
						var timeA = a.updated ? a.updated.valueOf() : a.date.valueOf();
						var timeB = b.updated ? b.updated.valueOf() : b.date.valueOf();
						return timeB - timeA;
						});
					%>

					<% posts_in_cat.each(function(post){ %>
						<li class="post-item">
							<span class="meta">
							<!-- 1. 严格读取 Front-Matter 的 date (创建时间) -->
							<span class="created-date">
							<%= date(post.date, 'YYYY-MM-DD') %>
							</span>

							<!-- 2. 只有在 Front-Matter 显式写了 updated，且与 date 不同时才显示 -->
							<%
								var cDate = date(post.date, 'YYYY-MM-DD');
								var uDate = post.updated ? date(post.updated, 'YYYY-MM-DD') : '';
							%>
							<% if (uDate && uDate !== cDate) { %>
							<span class="updated-date" style="color: #888; font-size: 0.85em; margin-left: 0.4rem;">
								(Updated at <%= uDate %>)
							</span>
							<% } %>
							</span>
							<span class="post-title">
							<a href="<%- url_for(post.path) %>"><%= post.title %></a>
							</span>
						</li>
					<% }); %>
				</ul>
				<% }); %>

				<!-- 未分类的文章 -->
				<% var uncategorized_posts = site.posts.filter(function(post) { return post.categories.length === 0; }).sort('-updated', '-date'); %>
				<% if (uncategorized_posts.length > 0) { %>
				<h2 class="category-title" id="Uncategorized">Uncategorized(<%= uncategorized_posts.length %>)</h2>
				<ul class="post-list">
					<% uncategorized_posts.each(function(post) { %>
					<li class="post-item">
						<span class="meta">
						<time datetime="<%= date_xml(post.updated || post.date) %>">
							<%= date(post.updated || post.date, 'YYYY-MM-DD') %>
						</time>
						</span>
						<span><a href="<%- url_for(post.path) %>"><%= post.title %></a></span>
					</li>
					<% }); %>
				</ul>
				<% } %>
			</div>
		<% } else { %>
		<%- page.content %>
		<% } %>
	</div>
</article>
